# Vercel / Next.js
SUPABASE_DATABASE_URL=postgresql://postgres.project:password@pooler.supabase.com:6543/postgres
SUPABASE_DB_SSL=true
DATABASE_POOL_SIZE=5
SESSION_SECRET=replace-with-at-least-32-random-bytes
EVENT_HOST_PASSWORD=replace-with-a-unique-host-password
JUDGE_QUEUE_ENABLED=true

# EC2 judge worker
WORKER_ID=judge-worker-1
WORKER_POLL_INTERVAL_MS=1000
WORKER_MAX_ATTEMPTS=3
WORKER_HEALTH_PORT=9091
SANDBOX_TIMEOUT_MS=8000
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=0.5
PYTHON_SANDBOX_IMAGE=python:3.12-slim
JAVA_SANDBOX_IMAGE=eclipse-temurin:21-jdk-jammy
