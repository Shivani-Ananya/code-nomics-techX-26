# ─────────────────────────────────────────────────────────────────
# Local Postgres (Docker) — works 100% offline on your laptop
# Start the DB with:  docker run -d --name code-auction-db --restart always -e POSTGRES_USER=codeauction -e POSTGRES_PASSWORD=localdev -e POSTGRES_DB=codeauction -p 5432:5432 -v code-auction-data:/var/lib/postgresql/data postgres:16-alpine
# ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://codeauction:localdev@localhost:5433/codeauction
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

# Session security — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-bytes-hex-string-here

# Host admin password (min 12 chars)
EVENT_HOST_PASSWORD=replace-with-a-unique-host-password

# Enable judge queue (set to false to disable code judging)
JUDGE_QUEUE_ENABLED=true

# ─── Judge worker (used by worker/src/index.ts) ──────────────────
WORKER_ID=judge-worker-1
WORKER_POLL_INTERVAL_MS=1000
WORKER_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=4
WORKER_HEALTH_PORT=9091
SANDBOX_TIMEOUT_MS=10000
SANDBOX_MEMORY_MB=256
SANDBOX_CPUS=0.5
PYTHON_SANDBOX_IMAGE=python:3.12-slim
JAVA_SANDBOX_IMAGE=eclipse-temurin:21-jdk-jammy
WORKER_WORKSPACE_ROOT=C:\temp\code-auction-worker
